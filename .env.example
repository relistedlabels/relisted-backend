# =============================================================================
# Relisted Backend - copy to `.env` and fill in real values
# =============================================================================

# --- Required for app + Prisma (PrismaService throws if missing) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/relisted?schema=public"

# --- Required for auth (JWT sign/verify) ---
JWT_SECRET="secret"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Swagger (basic auth in production) ---
# Set these in production to protect Swagger UI
SWAGGER_USERNAME=""
SWAGGER_PASSWORD=""

# --- Frontend ---
FRONTEND_URL="http://localhost:3000"

# --- Admin dashboard links (emails / alerts) ---
# Shipments UI lives at /admin/{ADMIN_SECRET_SEGMENT}/shipments (see RELISTED-frontend1 admin layout).
# Optional: set full list URL instead (overrides origin + segment):
# ADMIN_SHIPMENTS_PAGE_URL="http://localhost:3000/admin/k340eol21/shipments"
# ADMIN_SECRET_SEGMENT defaults to k340eol21 if unset (must match frontend adminSecretId).
# ADMIN_SECRET_SEGMENT="k340eol21"
# Legacy: ADMIN_URL as site origin still works as fallback before FRONTEND_URL / CLIENT_URL
# ADMIN_URL="http://localhost:3000"

# --- Mail ---
# Production: set RESEND_API_KEY (Resend API). From address must be verified in Resend.
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"
# Use onboarding@resend.dev only for testing; use your domain after DNS verification.
MAIL_DEFAULT="Relisted <onboarding@resend.dev>"

# SMTP (nodemailer): primary when RESEND_API_KEY is unset; also used if Resend returns an error.
# Gmail example: MAIL_HOST="smtp.gmail.com" MAIL_PORT=587 (use an app password, not your login password).
MAIL_HOST="smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USERNAME="mock-mailtrap-user"
MAIL_PASSWORD="mock-mailtrap-pass"

# Optional: log emails to ./dev-emails instead of sending (local debugging).
# DEV_EMAIL_BYPASS="true"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="mock-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="mock-api-secret"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Note: callback URL is hardcoded in google.strategy.ts (localhost:3000); adjust there if needed

# --- Topship ---
TOPSHIP_API_URL=""
TOPSHIP_API_KEY=""
# Optional: defaults to 45000 in code if unset
TOPSHIP_HTTP_TIMEOUT_MS=""
# Optional: cache pickup/shipment quote responses this many ms across requests (0 = off). Helps repeat GET /order/summary.
TOPSHIP_QUOTE_CACHE_TTL_MS=""

# --- Shipping fulfillment (checkout quotes + dispatch routing) ---
# Comma-separated: topship (default), chowdeck_relay. Examples: topship | chowdeck_relay | topship,chowdeck_relay
# Return legs still use Topship quotes only; outbound and resale can show Chowdeck Relay when enabled.
SHIPPING_FULFILLMENT_PROVIDERS="topship"

# --- Chowdeck Relay API (https://chowdeck.readme.io/reference/getting-started-with-relay) ---
# Bearer token from Chowdeck Relay (dashboard). Required when chowdeck_relay is listed above.
# "Vendor not found" on fee quotes usually means the key is valid but Relay vendor onboarding
# is incomplete on Chowdeck's side — confirm with Chowdeck support or test GET /relay/wallet/balance.
CHOWDECK_API_KEY=""
# Optional override; default is https://api.chowdeck.com/relay
# CHOWDECK_RELAY_API_BASE_URL="https://api.chowdeck.com/relay"
# Optional HTTP timeout ms for Relay calls (default 45000)
# CHOWDECK_HTTP_TIMEOUT_MS="45000"
# Relay fee quotes geocode pickup/drop-off via Nominatim before calling Chowdeck (coordinates are required).
# If an estate name is not in OpenStreetMap, the backend falls back to city + state (e.g. Lekki, Lagos).
# Nominatim (https://operations.osmfoundation.org/policies/nominatim/): set a stable User-Agent with contact.
# NOMINATIM_USER_AGENT="RelistedBackend/1.0 (you@example.com)"
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# NOMINATIM_HTTP_TIMEOUT_MS="12000"
# NOMINATIM_MIN_INTERVAL_MS="1100"

# --- Redis / Bull Queue (for shipment dispatch) ---
# Prefer REDIS_URL on Render (includes auth), e.g. redis://:password@host:6379 or rediss://...
REDIS_URL=""
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Set true if using host/port against a TLS-only Redis (not needed when REDIS_URL is rediss://)
REDIS_TLS=""

# --- Cron schedules (Africa/Lagos on @Cron decorators in shipment-dispatch.scheduler) ---
# Auto Topship dispatch: enqueue PENDING legs whose window is due (manual Relisted dispatch is excluded).
# DISPATCH_CRON="0 * * * *"
# Minutes ahead of "now" to treat a window as due when scanning (default 59).
# DISPATCH_CRON_LOOKAHEAD_MINUTES="59"

# Carrier tracking poll for in-flight shipments.
# POLLING_CRON="*/10 * * * *"

# Lister email when return pickup window ended but return not yet marked delivered (grace after window end).
# LISTER_RETURN_WINDOW_CRON="45 * * * *"
# LISTER_RETURN_WINDOW_PASSED_GRACE_HOURS="6"

# Renter return due reminders (24h before + morning-of Lagos). Uses shipment RETURN window dates.
# RETURN_DUE_REMINDER_CRON="*/15 * * * *"
# RETURN_DUE_REMINDER_MORNING_HOUR="8"
# If > 0, also notify renters within this many hours after pickup start if the morning email was missed.
# RETURN_DUE_REMINDER_MORNING_CATCHUP_HOURS="0"

# Admin reminders for pending manual Relisted dispatch legs (24h + same morning-of rules as renters).
# Defaults to same cron as RETURN_DUE_REMINDER_CRON if unset.
# MANUAL_FULFILLMENT_DUE_REMINDER_CRON="*/15 * * * *"

# --- Dispatch window defaults (used when building checkout windows; see src/utils/dispatch-windows.ts) ---
# IMMEDIATE_DISPATCH_THRESHOLD_MINUTES="60"
# DEFAULT_DISPATCH_WINDOW_HOURS="2"
# MIN_DISPATCH_WINDOW_MINUTES="60"
# MAX_DISPATCH_WINDOW_MINUTES="240"
# DISPATCH_WINDOW_START_HOUR="8"
# DISPATCH_WINDOW_END_HOUR="14"

# --- Client URL (for email links, etc.) ---
CLIENT_URL="http://localhost:3000"
