# Relisted Backend
#
# Setup:
#   cp .env.example .env
#   Fill in values below. Do not commit `.env`.
#
# Required: DATABASE_URL, JWT_SECRET
# Mail: set RESEND_API_KEY and/or SMTP (MAIL_*). See Mail section.
# Shipping: TOPSHIP_* for quotes/dispatch; optional Chowdeck Relay (see Shipping).

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/relisted?schema=public"
JWT_SECRET="change-me"

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Links in emails and notifications (auth, orders, disputes, etc.)
CLIENT_URL="http://localhost:3000"

# Fallback for some admin alert URLs if CLIENT_URL is unset
FRONTEND_URL="http://localhost:3000"

# Public base URL for API-hosted assets (local uploads). Defaults to http://localhost:{PORT}
# API_PUBLIC_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# Swagger (production only: set both to enable basic auth)
# -----------------------------------------------------------------------------

SWAGGER_USERNAME=""
SWAGGER_PASSWORD=""

# -----------------------------------------------------------------------------
# Admin alerts (shipments page links in emails)
# -----------------------------------------------------------------------------

# Full URL overrides origin + segment below
# ADMIN_SHIPMENTS_PAGE_URL="http://localhost:3000/admin/your-segment/shipments"

# Must match RELISTED-frontend1 admin route segment (default: k340eol21)
ADMIN_SECRET_SEGMENT="k340eol21"

# Optional site origin fallback (before FRONTEND_URL / CLIENT_URL)
# ADMIN_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

# Resend (preferred in production). https://resend.com/api-keys
RESEND_API_KEY=""
MAIL_DEFAULT="Relisted <onboarding@resend.dev>"

# SMTP fallback when RESEND_API_KEY is unset, or when Resend errors
MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""

# Write emails to ./dev-emails instead of sending (local only)
# DEV_EMAIL_BYPASS=true

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------

# cloudinary (default) | local (dev only: files under ./uploads, served by API)
# UPLOAD_STORAGE=local

# Legacy alias for local uploads
# LOCAL_FILE_UPLOAD=true

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# Auth: Google OAuth
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Callback URL is set in src/module/auth/strategies/google.strategy.ts

# -----------------------------------------------------------------------------
# Topship
# -----------------------------------------------------------------------------

TOPSHIP_API_URL="https://topship-staging.africa/api"
TOPSHIP_API_KEY=""
# TOPSHIP_HTTP_TIMEOUT_MS=45000
# TOPSHIP_QUOTE_CACHE_TTL_MS=0

# -----------------------------------------------------------------------------
# Shipping fulfillment
# -----------------------------------------------------------------------------

# Comma-separated: topship, chowdeck_relay, shipbubble (e.g. topship,chowdeck_relay,shipbubble)
# Return legs still quote via Topship only.
# SHIPPING_FULFILLMENT_PROVIDERS=topship

CHOWDECK_API_KEY=""
# CHOWDECK_RELAY_API_BASE_URL=https://api.chowdeck.com/relay
# CHOWDECK_HTTP_TIMEOUT_MS=45000

SHIPBUBBLE_API_KEY=sb_prod_91793f516925e7eb84009df5a9c49b4942fead4eef9faea2866eea827ecb58f4
# SHIPBUBBLE_API_BASE_URL=https://api.shipbubble.com/v1
# SHIPBUBBLE_HTTP_TIMEOUT_MS=45000
# Retries when fetch_rates returns no qualifying couriers or the request fails (default 5 attempts, 500ms base backoff)
# SHIPBUBBLE_QUOTE_MAX_ATTEMPTS=5
# SHIPBUBBLE_QUOTE_RETRY_DELAY_MS=500
# SHIPBUBBLE_CATEGORY_ID=
# SHIPBUBBLE_CATEGORY_NAME=Fashion wears
# SHIPBUBBLE_PACKAGE_LENGTH_CM=30
# SHIPBUBBLE_PACKAGE_WIDTH_CM=20
# SHIPBUBBLE_PACKAGE_HEIGHT_CM=10
# SHIPBUBBLE_DEFAULT_PACKAGE_WEIGHT_KG=1

# Shipbubble address validation cache: Redis (hot) + Postgres (durable)
# SHIPBUBBLE_ADDRESS_REDIS_CACHE_TTL_MS=86400000
# Set to 0 to disable Redis layer while keeping DB cache
# SHIPBUBBLE_ADDRESS_REDIS_CACHE=0

# Shipbubble webhooks (POST /webhook/shipbubble) — register URL in Shipbubble dashboard
# Signed with HMAC-SHA512 (header x-ship-signature) using SHIPBUBBLE_API_KEY
# SHIPBUBBLE_WEBHOOK_ENABLED=1
# Local only: skip signature verify when secret unset (never use in production)
# SHIPBUBBLE_WEBHOOK_SKIP_VERIFY=0

# Geocoding for Chowdeck Relay quotes (Nominatim / OpenStreetMap)
# NOMINATIM_USER_AGENT=RelistedBackend/1.0 (you@example.com)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_HTTP_TIMEOUT_MS=12000
# NOMINATIM_MIN_INTERVAL_MS=1100
# NOMINATIM_CACHE_TTL_MS=86400000

# -----------------------------------------------------------------------------
# Redis (Bull queues: shipment dispatch, order jobs)
# -----------------------------------------------------------------------------

# Prefer REDIS_URL on hosted Redis (e.g. rediss://:password@host:6379)
REDIS_URL=""
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""
# REDIS_TLS=true

# -----------------------------------------------------------------------------
# Wema virtual accounts (webhook auth)
# -----------------------------------------------------------------------------

WEMA_BEARER_TOKEN=""

# -----------------------------------------------------------------------------
# Cron schedules (Africa/Lagos; defaults shown)
# -----------------------------------------------------------------------------

# DISPATCH_CRON="0 * * * *"
# DISPATCH_CRON_LOOKAHEAD_MINUTES=59
# POLLING_CRON="*/10 * * * *"
# LISTER_RETURN_WINDOW_CRON="45 * * * *"
# LISTER_RETURN_WINDOW_PASSED_GRACE_HOURS=6
# RETURN_DUE_REMINDER_CRON="*/15 * * * *"
# RETURN_DUE_REMINDER_MORNING_HOUR=8
# RETURN_DUE_REMINDER_MORNING_CATCHUP_HOURS=0
# MANUAL_FULFILLMENT_DUE_REMINDER_CRON="*/15 * * * *"
# RETURN_REQUEST_REMINDER_CRON="* * * * *"
# RETURN_REQUEST_REMINDER_MORNING_HOUR=8
# RETURN_REQUEST_PAST_DUE_MORNING_HOUR=8
# RETURN_REQUEST_PAST_DUE_AFTERNOON_HOUR=14
# RETURN_REQUEST_PAST_DUE_EVENING_HOUR=20
# LATE_RETURN_COLLATERAL_PENALTY_ENABLED=false
# LATE_RETURN_COLLATERAL_PENALTY_PERCENT=5

# -----------------------------------------------------------------------------
# Dispatch windows (checkout defaults; see src/utils/dispatch-windows.ts)
# -----------------------------------------------------------------------------

# IMMEDIATE_DISPATCH_THRESHOLD_MINUTES=60
# DEFAULT_DISPATCH_WINDOW_MINUTES=60
# MIN_DISPATCH_WINDOW_MINUTES=60
# DEFAULT_DISPATCH_WINDOW_HOURS=1
# MAX_DISPATCH_WINDOW_MINUTES=240
# DISPATCH_WINDOW_START_HOUR=8
# DISPATCH_WINDOW_END_HOUR=14
# RETURN_DISPATCH_WINDOW_START_HOUR=8
# RETURN_DISPATCH_WINDOW_END_HOUR=17

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# -----------------------------------------------------------------------------

SENTRY_DSN="https://67fe20100c29c638fc055d1541e05270@o4511274615767040.ingest.de.sentry.io/4511274688184400"

# -----------------------------------------------------------------------------
# Logging and debugging
# -----------------------------------------------------------------------------

# HTTP_ENABLE_ACCESS_LOG=true
# HTTP_LOG_VERBOSE=true
# HTTP_LOG_MAX_JSON_CHARS=4096
# DEBUG_TOPSHIP_RATES=1

# Admin analytics / wallet stats (orders since this date; default 2026-04-01)
# ADMIN_ORDER_ANALYTICS_CUTOFF=2026-04-01T00:00:00.000Z

# Resale: hours after order DELIVERED before auto-completing and releasing escrow (default 24)
# RESALE_INSPECTION_HOURS=24
# Legacy: RESALE_INSPECTION_DAYS=1 (converted to hours)
# RESALE_INSPECTION_RELEASE_CRON=0 * * * *

# Hide internal staging curator from storefront and wallet balance totals
# STAGING_INTERNAL_CURATOR_ID=
