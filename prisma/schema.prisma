generator client {
  provider = "prisma-client-js"
  // output ="/dbml"
}

generator dbml {
  provider   = "prisma-dbml-generator"
  output     = "./dbml"
  outputName = "schema.dbml"
  // projectName=""
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LISTER
  RENTER
}

enum AuthOtpTokenType {
  TOKEN
  OTP
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  AVAILABLE
  UNAVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  ACTIVE
  RETURN_DUE
  RETURNED
  COMPLETED
  CANCELLED
  ACCEPTED
  //  PENDING
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String
  provider        String?
  isVerified      Boolean           @default(false)
  isSuspended     Boolean           @default(false)
  role            Role              @default(RENTER)
  tokenVersion    Int               @default(0)
  curatorReviews  Review[]          @relation("CuratorReviews")
  reviewsWritten  Review[]
  tokens          AuthOtpToken[]
  products        Product[]         @relation("CuratedProducts")
  cart            Cart?
  favourites      Favourite[]
  orders          Order[]
  wallet          Wallet?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profile         Profile?
  uploads         Upload[]
  disputes        Dispute[]
  rentalsRented   Rental[]          @relation("Rentee")
  rentalsCurated  Rental[]          @relation("Curator")
  virtualAccounts VirtualAccount[]
  transactions    Transaction[]
  brands          Brand[]
  productCategory ProductCategory[]
  // fullText        String            @default("")
  tags            Tag[]
  
  bankAccounts       BankAccount[]
  withdrawalRequests WithdrawalRequest[]
  notificationSettings NotificationSettings?

  adminRoleId String?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id])
  auditLogs   AuditLog[] @relation("AdminAuditLogs")
}

model Profile {
  id     String  @id @default(uuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])

  phoneNumber String

  bvn        String?
  nin        String?

  isApproved Boolean @default(false)

  // One-to-one relations
  emergencyContact EmergencyContact?  // optional
  businessInfo     BusinessInfo?      // optional
  address          Address?           // optional

  avatarUpload   Upload? @relation("AvatarUpload", fields: [avatarUploadId], references: [id])
  avatarUploadId String? @unique

  ninUpload   Upload? @relation("NinUpload", fields: [ninUploadId], references: [id])
  ninUploadId String? @unique

  idDocumentType    String?
  idDocumentStatus  String @default("NOT_UPLOADED")
  idDocumentUpload  Upload? @relation("IdDocumentUpload", fields: [idDocumentUploadId], references: [id])
  idDocumentUploadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmergencyContact {
  id        String  @id @default(uuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @unique  // one-to-one

  name         String
  relationship String
  phoneNumber  String
  city         String
  state        String
}

model BusinessInfo {
  id        String  @id @default(uuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @unique  // one-to-one

  businessName               String
  businessEmail              String
  businessRegistrationNumber String
  businessAddress            String
  businessCity               String
  businessState              String
  // Optional extended business metadata for lister dashboards
  businessPhone        String?
  businessDescription  String?
  businessCategory     String?
  website              String?
}

model Address {
  id        String  @id @default(uuid())
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @unique  // one-to-one

  street    String
  city      String
  state     String
  country   String
  zipCode   String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AuthOtpToken {
  id      String           @id @default(uuid())
  subject String
  type    AuthOtpTokenType @default(OTP)
  code    String           @unique
  expiry  DateTime
  email   String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String        @id @default(uuid())
  name            String
  subText         String
  description     String
  condition       String
  productVerified Boolean       @default(false)
  dailyPrice      Int
  isActive        Boolean       @default(true)
  quantity        Int?
  status          ProductStatus @default(PENDING)
  rejectionComment String?
  composition     String?
  measurement     String
  originalValue   Int
  collateralPrice Int?
  material        String?
  
  warning         String?
  color           String

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  tags Tag[]

  curatorId String
  curator   User   @relation("CuratedProducts", fields: [curatorId], references: [id])

  attachments Attachments?
 
  receiveSmsNotifications       Boolean? @default(false)
  receiveEmailNotifications     Boolean? @default(true)
  receiveProductRecommendations Boolean? @default(false)

  rentals    Rental[]
  cartItems  CartItem[]
  favourites Favourite[]
  reviews    Review[]

  careInstruction String
  careSteps       String
  items           OrderItem[]
  stylingTip      String
   AvailabilityRequests AvailabilityRequest[] 
  createdAt DateTime @default(now())
  // fullText  String   @default("")
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  // fullText  String    @default("")
  createdAt DateTime  @default(now())
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  // fullText  String    @default("")
  createdAt DateTime  @default(now())
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  imageUrl  String?
  products  Product[]
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  // fullText  String    @default("")
  createdAt DateTime  @default(now())
}

enum DisputeStatus {
  IN_REVIEW
  PENDING
  WITHDRAW
  RESELOVED
  REJECTED
}

model Upload {
  id              String       @id @default(uuid())
  name            String
  type            String
  size            Int
  url             String
  fieldName       String
  publicId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  attachmentId    String?
  profileAsAvatar Profile?     @relation("AvatarUpload")
  profileAsNin    Profile?     @relation("NinUpload")
  profileAsIdDoc  Profile?     @relation("IdDocumentUpload")
  attachment      Attachments? @relation(fields: [attachmentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  fullText        String       @default("")
  // dispute         Dispute?     @relation("DisputeUploads", fields: [disputeId], references: [id])
  // disputeId       String?
}



model Attachments {
  id      String   @id @default(uuid())
  uploads Upload[]

  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @unique
  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  disputeId String?  @unique
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  days      Int

  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Favourite {
  id        String @id @default(uuid())
  userId    String
  productId String

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  fullText  String   @default("")

  @@unique([userId, productId])
}



model AvailabilityRequest {
  id          String   @id @default(uuid())
  productId   String
  cartItemId String
  requesterId String   
  listerId    String   
  status      AvailabilityStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])

  // Rental Request Fields
  startDate         DateTime?
  endDate           DateTime?
  rentalDays        Int?
  totalPrice        Int?
  deliveryAddressId String?
  autoPay           Boolean  @default(false)
}

enum AvailabilityStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Order {
  id         String      @id @default(uuid())
  orderId    String      @unique
  status     OrderStatus @default(PROCESSING)
  expiresAt  DateTime?   // 15-min approval window; null once approved/expired
  approvedAt DateTime?

  // Shipping / tracking metadata (for lister dashboards & dispatch workflow)
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  returnDueAt           DateTime?
  externalTrackingUrl   String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rental             Rental?
  payments           Transaction[]
  disputes           Dispute[]
  walletTransactions WalletTransaction[]
  orderItems         OrderItem[]
  escrows            Escrow?
  virtualAccount     VirtualAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  productId   String
  days        Int
  pricePerDay Int

  order Order @relation(fields: [orderId], references: [id])

  product Product @relation(fields: [productId], references: [id])
}

model Rental {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
  curatorId String
  curator   User    @relation("Curator", fields: [curatorId], references: [id])
  userId    String
  user      User    @relation("Rentee", fields: [userId], references: [id])

  days Int

  totalAmount Int

  startDate  DateTime
  endDate    DateTime
  returnedAt DateTime?
  review     Review?

  isReturned Boolean @default(false)
  isOverdue  Boolean @default(false)

  createdAt DateTime @default(now())
}



model Review {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  curatorId String
  curator   User   @relation("CuratorReviews", fields: [curatorId], references: [id])

  rating   Int
  comment  String?
  rentalId String  @unique
  rental   Rental  @relation(fields: [rentalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Dispute {
  id        String @id @default(uuid())
  disputeId String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  issueCategory String
  description   String
  status        DisputeStatus @default(PENDING)
  attachment    Attachments?

  chatRooms ChatRoom?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatRoom {
  id        String    @id @default(uuid())
  dispute   Dispute?  @relation(fields: [disputeId], references: [id])
  disputeId String?   @unique
  message   Message[]
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  senderRole String
  content    String
  type       String    @default("TEXT")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
  chatRoomId String
}

model Transaction {
  id          String            @id @default(uuid())
  referenceId String            @unique
  amount      Int
  method      String?
  status      TransactionStatus @default(PENDING)
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id])

  user             User            @relation(fields: [userId], references: [id])
  userId           String
  virtualAccountId String?
  virtualAccount   VirtualAccount? @relation(fields: [virtualAccountId], references: [id])

  // Wema Bank Webhook Fields
  sessionId                 String? @unique
  paymentReference          String?
  originatorName            String?
  originatorAccountNumber   String?
  bankName                  String?
  narration                 String?
  crAccountName             String?
  crAccount                 String?
  bankCode                  String?

  createdAt        DateTime        @default(now())
}

model Wallet {
  id String @id @default(uuid())

  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
  // Three balances
  mainBalance       Int                 @default(0)
  availableBalance  Int                 @default(0)
  collateralBalance Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaitList {
  id    String @id @default(uuid())
  email String @unique
}

enum WalletTransactionType {
  MAIN
  AVAILABLE
  COLLATERAL
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  amount Int
  type   WalletTransactionType   @default(MAIN)
  status WalletTransactionStatus @default(PENDING)
  note   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escrow {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  renterId  String
  curatorId String

  rentalAmount     Int
  collateralAmount Int
  cleaningFee      Int

  status EscrowStatus @default(LOCKED)

  releasedAt DateTime?
  createdAt  DateTime  @default(now())
}

enum EscrowStatus {
  LOCKED
  RELEASED
  PARTIALLY_RELEASED
  REFUNDED
}

enum VirtualAccountStatus {
  PENDING
  PAID
  EXPIRED
  INACTIVE
}

model VirtualAccount {
  id           String               @id @default(uuid())
  prefix       String
  vaNumber     String               @unique
  orderId      String?              @unique
  nin          String?
  bvn          String?
  order        Order?               @relation(fields: [orderId], references: [id])
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  amount       Int?
  status       VirtualAccountStatus @default(PENDING)
  blockReason  String?
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions Transaction[]
}

model ContactSubmission {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("RECEIVED") // RECEIVED, IN_REVIEW, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  bankName          String
  bankCode          String?
  accountNumber     String
  accountName       String
  accountType       String?
  isDefault         Boolean  @default(false)
  verificationStatus String   @default("PENDING")
  verifiedAt        DateTime?
  
  withdrawals       WithdrawalRequest[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WithdrawalRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Int
  currency      String   @default("NGN")
  
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  status        String   @default("PENDING")
  reference     String   @unique
  fee           Int      @default(0)
  netAmount     Int

  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  emailAlertsEnabled Boolean @default(true)
  emailAlertsCategories String[] 
  
  smsUpdatesEnabled Boolean @default(false)
  smsUpdatesCategories String[]
  
  marketingEmailsEnabled Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actionType  String
  performedBy String
  admin       User     @relation("AdminAuditLogs", fields: [performedBy], references: [id])
  targetType  String
  targetId    String
  targetName  String
  details     Json?
  ipAddress   String?
  status      String   @default("Success")
  createdAt   DateTime @default(now())
}
