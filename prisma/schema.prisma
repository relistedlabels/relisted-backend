generator client {
  provider = "prisma-client-js"
  // output ="/dbml"
}

generator dbml {
  provider   = "prisma-dbml-generator"
  output     = "./dbml"
  outputName = "schema.dbml"
  // projectName=""
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CURATOR
  DRESSER
}

enum AuthOtpTokenType {
  TOKEN
  OTP
}

enum ProductStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum WalletTransactionStatus {
  DEBIT
  CREDIT
  LOCKED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  ACTIVE
  RETURN_DUE
  RETURNED
  COMPLETED
  CANCELLED
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  name       String
  provider   String?
  isVerified Boolean @default(false)
  role       Role    @default(DRESSER)

  tokens     AuthOtpToken[]
  products   Product[]      @relation("CuratedProducts")
  cart       Cart?
  favourites Favourite[]
  orders     Order[]

  wallet Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?
  uploads   Upload[]
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phoneNumber String

  bvn        String
  isApproved Boolean @default(false)

  emergencyContacts EmergencyContact[]
  businessInfo      BusinessInfo[]
  bankAccounts      BankInfo[]
  // attachments  Attachments? 

  address Address[]

  avatarUpload   Upload? @relation("AvatarUpload", fields: [avatarUploadId], references: [id])
  avatarUploadId String? @unique

  ninUpload   Upload? @relation("NinUpload", fields: [ninUploadId], references: [id])
  ninUploadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmergencyContact {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  name         String
  relationship String
  phoneNumber  String
  city         String
  state        String
}

model BusinessInfo {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id])

  businessName               String
  businessEmail              String
  businessRegistrationNumber String
  businessAddress            String
  businessCity               String
  businessState              String
}

model BankInfo {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  bankName      String
  accountNumber String
  nameOfAccount String
}

model Address {
  id String @id @default(uuid())

  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String
  street    String
  city      String
  state     String
  country   String
  zipCode   String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthOtpToken {
  id      String           @id @default(uuid())
  subject String
  type    AuthOtpTokenType @default(OTP)
  code    String           @unique
  expiry  DateTime
  email   String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String @id @default(uuid())
  name        String
  subText     String
  description String
  condition   String

  dailyPrice    Int
  isActive      Boolean       @default(true)
  status        ProductStatus @default(AVAILABLE)
  composition   String
  measurement   String
  originalValue String
  warning       String
  color         String[]

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  curatorId String
  curator   User   @relation("CuratedProducts", fields: [curatorId], references: [id])

  attachments Attachments?

  rentals         Rental[]
  cartItems       CartItem[]
  favourites      Favourite[]
  careInstruction String
  careSteps       String[]
  stylingTip      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Upload {
  id              String       @id @default(uuid())
  name            String
  type            String
  size            Int
  url             String
  fieldName       String
  publicId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  attachmentId    String?
  profileAsAvatar Profile?     @relation("AvatarUpload")
  profileAsNin    Profile?     @relation("NinUpload")
  attachment      Attachments? @relation(fields: [attachmentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  userId          String
}

model Attachments {
  id      String   @id @default(uuid())
  uploads Upload[]

  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @unique
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  days      Int

  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Favourite {
  id        String @id @default(uuid())
  userId    String
  productId String

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id      String      @id @default(uuid())
  orderId String      @unique
  status  OrderStatus @default(PROCESSING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rental   Rental?
  payments Transaction[]

  createdAt DateTime @default(now())
}

model Rental {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  days Int

  totalAmount Int

  startDate  DateTime
  endDate    DateTime
  returnedAt DateTime?

  isReturned Boolean @default(false)
  isOverdue  Boolean @default(false)

  createdAt DateTime @default(now())
}

model Transaction {
  id            String @id @default(uuid())
  transactionId String @unique
  amount        Int
  method        String
  status        String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model Wallet {
  id      String @id @default(uuid())
  balance Int    @default(0)

  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  amount Int
  status WalletTransactionStatus @default(LOCKED)
  note   String?

  createdAt DateTime @default(now())
}
