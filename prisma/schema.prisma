generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider   = "prisma-dbml-generator"
  output     = "./dbml"
  outputName = "schema.dbml"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  provider        String?
  isVerified      Boolean          @default(false)
  role            Role             @default(DRESSER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tokens          AuthOtpToken[]
  cart            Cart?
  disputes        Dispute[]
  favourites      Favourite[]
  orders          Order[]
  products        Product[]        @relation("CuratedProducts")
  profile         Profile?
  rentalsCurated  Rental[]         @relation("Curator")
  rentalsRented   Rental[]         @relation("Rentee")
  curatorReviews  Review[]         @relation("CuratorReviews")
  reviewsWritten  Review[]
  uploads         Upload[]
  virtualAccounts VirtualAccount[]
  wallet          Wallet?
}

model Profile {
  id                String             @id @default(uuid())
  userId            String             @unique
  phoneNumber       String
  bvn               String
  isApproved        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  avatarUploadId    String?            @unique
  ninUploadId       String?            @unique
  address           Address[]
  bankAccounts      BankInfo[]
  businessInfo      BusinessInfo?
  emergencyContacts EmergencyContact[]
  avatarUpload      Upload?            @relation("AvatarUpload", fields: [avatarUploadId], references: [id])
  ninUpload         Upload?            @relation("NinUpload", fields: [ninUploadId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  profileId    String
  name         String
  relationship String
  phoneNumber  String
  city         String
  state        String
  profile      Profile @relation(fields: [profileId], references: [id])
}

model BusinessInfo {
  id                         String  @id @default(uuid())
  profileId                  String  @unique
  businessName               String
  businessEmail              String
  businessRegistrationNumber String
  businessAddress            String
  businessCity               String
  businessState              String
  profile                    Profile @relation(fields: [profileId], references: [id])
}

model BankInfo {
  id            String  @id @default(uuid())
  profileId     String
  bankName      String
  accountNumber String
  nameOfAccount String
  profile       Profile @relation(fields: [profileId], references: [id])
}

model Address {
  id        String   @id @default(uuid())
  profileId String
  street    String
  city      String
  state     String
  country   String
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model AuthOtpToken {
  id        String           @id @default(uuid())
  subject   String
  type      AuthOtpTokenType @default(OTP)
  code      String           @unique
  expiry    DateTime
  email     String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Product {
  id                            String          @id @default(uuid())
  name                          String
  subText                       String
  description                   String
  condition                     String
  dailyPrice                    Int
  isActive                      Boolean         @default(true)
  composition                   String
  measurement                   String
  warning                       String
  color                         String[]
  brandId                       String
  categoryId                    String
  curatorId                     String
  careInstruction               String
  careSteps                     String[]
  stylingTip                    String
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  receiveEmailNotifications     Boolean?        @default(true)
  receiveProductRecommendations Boolean?        @default(false)
  receiveSmsNotifications       Boolean?        @default(false)
  originalValue                 Int
  attachments                   Attachments?
  cartItems                     CartItem[]
  favourites                    Favourite[]
  items                         OrderItem[]
  brand                         Brand           @relation(fields: [brandId], references: [id])
  category                      ProductCategory @relation(fields: [categoryId], references: [id])
  curator                       User            @relation("CuratedProducts", fields: [curatorId], references: [id])
  rentals                       Rental[]
  reviews                       Review[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Upload {
  id              String       @id @default(uuid())
  name            String
  type            String
  size            Int
  url             String
  publicId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  attachmentId    String?
  userId          String
  fieldName       String
  profileAsAvatar Profile?     @relation("AvatarUpload")
  profileAsNin    Profile?     @relation("NinUpload")
  attachment      Attachments? @relation(fields: [attachmentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
}

model Attachments {
  id        String   @id @default(uuid())
  productId String?  @unique
  disputeId String?  @unique
  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  uploads   Upload[]
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  days      Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id                 String              @id @default(uuid())
  orderId            String              @unique
  status             OrderStatus         @default(PROCESSING)
  userId             String
  createdAt          DateTime            @default(now())
  disputes           Dispute[]
  escrows            Escrow?
  user               User                @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
  rental             Rental?
  payments           Transaction[]
  virtualAccount     VirtualAccount?
  walletTransactions WalletTransaction[]
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  days        Int
  pricePerDay Int
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Rental {
  id          String    @id @default(uuid())
  orderId     String    @unique
  productId   String
  days        Int
  totalAmount Int
  startDate   DateTime
  endDate     DateTime
  returnedAt  DateTime?
  isReturned  Boolean   @default(false)
  isOverdue   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  curatorId   String
  userId      String
  curator     User      @relation("Curator", fields: [curatorId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  user        User      @relation("Rentee", fields: [userId], references: [id])
  review      Review?
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  curatorId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rentalId  String   @unique
  curator   User     @relation("CuratorReviews", fields: [curatorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  rental    Rental   @relation(fields: [rentalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Dispute {
  id            String        @id @default(uuid())
  orderId       String
  userId        String
  issueCategory String
  description   String
  status        DisputeStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  disputeId     String        @unique
  attachment    Attachments?
  chatRooms     ChatRoom?
  order         Order         @relation(fields: [orderId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id        String    @id @default(uuid())
  disputeId String?   @unique
  dispute   Dispute?  @relation(fields: [disputeId], references: [id])
  message   Message[]
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  senderRole String
  content    String
  type       String    @default("TEXT")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  chatRoomId String
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
}

model Transaction {
  id               String            @id @default(uuid())
  transactionId    String            @unique
  amount           Int
  method           String
  orderId          String
  createdAt        DateTime          @default(now())
  status           TransactionStatus @default(PENDING)
  virtualAccountId String?
  order            Order             @relation(fields: [orderId], references: [id])
  virtualAccount   VirtualAccount?   @relation(fields: [virtualAccountId], references: [id])
}

model Wallet {
  id                String              @id @default(uuid())
  balance           Int                 @default(0)
  userId            String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  availableBalance  Int                 @default(0)
  collateralBalance Int                 @default(0)
  mainBalance       Int                 @default(0)
  user              User                @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
}

model WaitList {
  id    String @id @default(uuid())
  email String @unique
}

model WalletTransaction {
  id        String                  @id @default(uuid())
  walletId  String
  amount    Int
  status    WalletTransactionStatus @default(PENDING)
  note      String?
  createdAt DateTime                @default(now())
  orderId   String?
  type      WalletTransactionType   @default(MAIN)
  updatedAt DateTime                @updatedAt
  order     Order?                  @relation(fields: [orderId], references: [id])
  wallet    Wallet                  @relation(fields: [walletId], references: [id])
}

model Escrow {
  id               String       @id @default(uuid())
  orderId          String       @unique
  renterId         String
  curatorId        String
  rentalAmount     Int
  collateralAmount Int
  cleaningFee      Int
  status           EscrowStatus @default(LOCKED)
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  order            Order        @relation(fields: [orderId], references: [id])
}

model VirtualAccount {
  id           String               @id @default(uuid())
  vaNumber     String               @unique
  orderId      String?              @unique
  userId       String
  amount       Int
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  prefix       String
  status       VirtualAccountStatus @default(PENDING)
  bvn          String?
  nin          String?
  transactions Transaction[]
  order        Order?               @relation(fields: [orderId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  CURATOR
  DRESSER
}

enum AuthOtpTokenType {
  TOKEN
  OTP
}

enum ProductStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  ACTIVE
  RETURN_DUE
  RETURNED
  COMPLETED
  CANCELLED
  ACCEPTED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum DisputeStatus {
  IN_REVIEW
  PENDING
  WITHDRAW
  RESELOVED
  REJECTED
}

enum WalletTransactionType {
  MAIN
  AVAILABLE
  COLLATERAL
}

enum EscrowStatus {
  LOCKED
  RELEASED
  PARTIALLY_RELEASED
  REFUNDED
}

enum VirtualAccountStatus {
  PENDING
  PAID
  EXPIRED
}
