generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator dbml {
  provider   = "prisma-dbml-generator"
  output     = "./dbml"
  outputName = "schema.dbml"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               String                            @id @default(uuid())
  email                            String                            @unique
  password                         String
  name                             String
  provider                         String?
  isVerified                       Boolean                           @default(false)
  role                             Role                              @default(RENTER)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  tokenVersion                     Int                               @default(0)
  isSuspended                      Boolean                           @default(false)
  adminRoleId                      String?
  auditLogs                        AuditLog[]                        @relation("AdminAuditLogs")
  tokens                           AuthOtpToken[]
  listerRequests                   AvailabilityRequest[]             @relation("ListerAvailability")
  requestedAvailability            AvailabilityRequest[]             @relation("RequestedAvailability")
  bankAccounts                     BankAccount[]
  brands                           Brand[]
  cart                             Cart?
  disputes                         Dispute[]
  favourites                       Favourite[]
  notifications                    Notification[]
  notificationSettings             NotificationSettings?
  orders                           Order[]
  products                         Product[]                         @relation("CuratedProducts")
  productCategory                  ProductCategory[]
  profile                          Profile?
  sentMessages                     Message[]                         @relation("MessageSender")
  rentalsCurated                   Rental[]                          @relation("Curator")
  rentalsRented                    Rental[]                          @relation("Rentee")
  orderListers                     OrderLister[]                     @relation("OrderListers")
  curatorReviews                   Review[]                          @relation("CuratorReviews")
  reviewsWritten                   Review[]
  tags                             Tag[]
  transactions                     Transaction[]
  uploads                          Upload[]
  adminRole                        AdminRole?                        @relation(fields: [adminRoleId], references: [id])
  virtualAccounts                  VirtualAccount[]
  wallet                           Wallet?
  withdrawalRequests               WithdrawalRequest[]
  closets                          Closet[]
  productAvailabilityNotifications ProductAvailabilityNotification[]
}

model Profile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  fullName           String?
  businessName       String?
  phoneNumber        String
  bvn                String?
  isApproved         Boolean           @default(false)
  avatarUploadId     String?           @unique
  ninUploadId        String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  idDocumentStatus   String            @default("NOT_UPLOADED")
  idDocumentType     String?
  idDocumentUploadId String?           @unique
  nin                String?
  address            Address?
  businessInfo       BusinessInfo?
  emergencyContact   EmergencyContact?
  avatar             String?
  avatarUpload       Upload?           @relation("AvatarUpload", fields: [avatarUploadId], references: [id])
  idDocumentUpload   Upload?           @relation("IdDocumentUpload", fields: [idDocumentUploadId], references: [id])
  ninUpload          Upload?           @relation("NinUpload", fields: [ninUploadId], references: [id])
  user               User              @relation(fields: [userId], references: [id])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  profileId    String  @unique
  name         String
  email        String?
  relationship String
  phoneNumber  String
  city         String
  state        String
  profile      Profile @relation(fields: [profileId], references: [id])
}

model BusinessInfo {
  id                         String  @id @default(uuid())
  profileId                  String  @unique
  businessName               String
  businessEmail              String
  businessRegistrationNumber String
  businessAddress            String
  businessCity               String
  businessState              String
  businessPhone              String?
  businessDescription        String?
  businessCategory           String?
  website                    String?
  profile                    Profile @relation(fields: [profileId], references: [id])
}

model Address {
  id        String   @id @default(uuid())
  profileId String   @unique
  street    String
  city      String
  state     String
  country   String
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model AuthOtpToken {
  id        String           @id @default(uuid())
  subject   String
  type      AuthOtpTokenType @default(OTP)
  code      String           @unique
  expiry    DateTime
  email     String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Closet {
  id          String    @id @default(uuid())
  ownerId     String
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([ownerId])
}

model Product {
  id                               String                            @id @default(uuid())
  name                             String
  subText                          String
  description                      String
  condition                        String
  dailyPrice                       Int?
  isActive                         Boolean                           @default(true)
  listingType                      ListingType                       @default(RENTAL)
  resalePrice                      Int?
  rentalCount                      Int                               @default(0)
  composition                      String?
  measurement                      String
  originalValue                    Int
  warning                          String?
  color                            String
  brandId                          String?
  categoryId                       String?
  closetId                         String?
  curatorId                        String
  receiveSmsNotifications          Boolean?                          @default(false)
  receiveEmailNotifications        Boolean?                          @default(true)
  receiveProductRecommendations    Boolean?                          @default(false)
  careInstruction                  String
  careSteps                        String
  stylingTip                       String
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  productVerified                  Boolean                           @default(false)
  quantity                         Int?
  status                           ProductStatus                     @default(PENDING)
  rejectionComment                 String?
  material                         String?
  collateralPrice                  Int?
  attachments                      Attachments?
  AvailabilityRequests             AvailabilityRequest[]
  cartItems                        CartItem[]
  favourites                       Favourite[]
  items                            OrderItem[]
  brand                            Brand?                            @relation(fields: [brandId], references: [id])
  category                         ProductCategory?                  @relation(fields: [categoryId], references: [id])
  closet                           Closet?                           @relation(fields: [closetId], references: [id], onDelete: SetNull)
  curator                          User                              @relation("CuratedProducts", fields: [curatorId], references: [id])
  rentals                          Rental[]
  reviews                          Review[]
  tags                             Tag[]                             @relation("ProductToTag")
  productAvailabilityNotifications ProductAvailabilityNotification[]

  @@index([listingType])
  @@index([resalePrice])
  @@index([dailyPrice])
  @@index([closetId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  products  Product[]
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  userId    String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  products  Product[] @relation("ProductToTag")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  userId    String?
  imageUrl  String?
  products  Product[]
  user      User?     @relation(fields: [userId], references: [id])
}

model Upload {
  id              String       @id @default(uuid())
  name            String
  type            String
  size            Int
  url             String
  fieldName       String
  publicId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  attachmentId    String?
  userId          String
  fullText        String       @default("")
  profileAsAvatar Profile?     @relation("AvatarUpload")
  profileAsIdDoc  Profile?     @relation("IdDocumentUpload")
  profileAsNin    Profile?     @relation("NinUpload")
  attachment      Attachments? @relation(fields: [attachmentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  messages        Message[]
}

model Attachments {
  id        String   @id @default(uuid())
  productId String?  @unique
  disputeId String?  @unique
  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  uploads   Upload[]
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  days      Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  fullText  String   @default("")
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

/// Renters who asked to be emailed when a RENTED product is available again
model ProductAvailabilityNotification {
  id        String   @id @default(uuid())
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

model AvailabilityRequest {
  id                  String             @id @default(uuid())
  productId           String
  cartItemId          String
  requesterId         String
  listerId            String
  status              AvailabilityStatus @default(PENDING)
  expiresAt           DateTime
  createdAt           DateTime           @default(now())
  autoPay             Boolean            @default(false)
  rejectionReason     String?
  deliveryAddressId   String?
  endDate             DateTime?
  rentalDays          Int?
  startDate           DateTime?
  totalPrice          Int?
  outboundWindowStart DateTime?
  outboundWindowEnd   DateTime?
  returnWindowStart   DateTime?
  returnWindowEnd     DateTime?
  resaleWindowStart   DateTime?
  resaleWindowEnd     DateTime?
  lister              User               @relation("ListerAvailability", fields: [listerId], references: [id])
  product             Product            @relation(fields: [productId], references: [id])
  requester           User               @relation("RequestedAvailability", fields: [requesterId], references: [id])
}

model Order {
  id                          String              @id @default(uuid())
  orderId                     String              @unique
  status                      OrderStatus         @default(PROCESSING)
  listingType                 ListingType         @default(RENTAL)
  userId                      String
  createdAt                   DateTime            @default(now())
  expiresAt                   DateTime?
  approvedAt                  DateTime?
  updatedAt                   DateTime            @updatedAt
  trackingNumber              String?
  estimatedDeliveryDate       DateTime?
  dispatchedAt                DateTime?
  deliveredAt                 DateTime?
  returnDueAt                 DateTime?
  returnShipmentId            String?
  returnTrackingId            String?
  returnShippingTier          String?
  returnShippingFee           Int?
  returnPickupPartner         String?
  externalTrackingUrl         String?
  returnRequestReminderSentAt DateTime?
  returnReminderMorningSentAt DateTime?
  returnRequestPastDueSentAt  DateTime?
  shipmentId                  String?
  trackingId                  String?
  deliveryFee                 Int?
  listerBusinessName          String?
  listerImage                 String?
  listerRating                Float?
  serviceFee                  Int?
  totalAmountPaid             Int?
  vatAmount                   Int?
  disputes                    Dispute[]
  escrows                     Escrow[]
  user                        User                @relation(fields: [userId], references: [id])
  orderItems                  OrderItem[]
  rentals                     Rental[]
  returnRequests              ReturnRequest[]
  payments                    Transaction[]
  virtualAccount              VirtualAccount?
  walletTransactions          WalletTransaction[]
  shipments                   Shipment[]
  orderListers                OrderLister[]

  @@index([listingType])
}

model OrderLister {
  orderId  String
  listerId String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lister   User   @relation("OrderListers", fields: [listerId], references: [id], onDelete: Cascade)

  @@id([orderId, listerId])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  days          Int
  pricePerDay   Int
  cleaningFee   Int?
  collateralFee Int?
  imageUrl      String?
  rentalFee     Int?
  /// Checkout shipment leg for rental outbound (lister → renter).
  outboundShipmentId String?
  /// Checkout shipment leg for rental return (renter → lister).
  returnShipmentId   String?
  /// Checkout shipment leg for resale delivery (lister → buyer).
  resaleShipmentId   String?
  order              Order    @relation(fields: [orderId], references: [id])
  product            Product  @relation(fields: [productId], references: [id])
  outboundShipment   Shipment? @relation("OrderItemOutboundShipment", fields: [outboundShipmentId], references: [id])
  returnShipment     Shipment? @relation("OrderItemReturnShipment", fields: [returnShipmentId], references: [id])
  resaleShipment     Shipment? @relation("OrderItemResaleShipment", fields: [resaleShipmentId], references: [id])
}

model Rental {
  id          String    @id @default(uuid())
  orderId     String
  productId   String
  curatorId   String
  userId      String
  days        Int
  totalAmount Int
  startDate   DateTime
  endDate     DateTime
  returnedAt  DateTime?
  isReturned  Boolean   @default(false)
  isOverdue   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  curator     User      @relation("Curator", fields: [curatorId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  user        User      @relation("Rentee", fields: [userId], references: [id])
  review      Review?
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  curatorId String
  rating    Int
  comment   String?
  rentalId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  curator   User     @relation("CuratorReviews", fields: [curatorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  rental    Rental   @relation(fields: [rentalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Dispute {
  id                  String        @id @default(uuid())
  disputeId           String        @unique
  orderId             String
  userId              String
  issueCategory       String
  description         String
  preferredResolution String?
  resolutionDetails   String?
  status              DisputeStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  attachment          Attachments?
  chatRooms           ChatRoom?
  order               Order         @relation(fields: [orderId], references: [id])
  user                User          @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id        String    @id @default(uuid())
  disputeId String?   @unique
  dispute   Dispute?  @relation(fields: [disputeId], references: [id])
  message   Message[]
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  senderRole String
  content    String
  type       String    @default("TEXT")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  chatRoomId String
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
  sender     User      @relation("MessageSender", fields: [senderId], references: [id])
  uploads    Upload[]
}

model Transaction {
  id                      String            @id @default(uuid())
  amount                  Int
  method                  String?
  status                  TransactionStatus @default(PENDING)
  orderId                 String?
  virtualAccountId        String?
  createdAt               DateTime          @default(now())
  referenceId             String            @unique
  userId                  String
  bankCode                String?
  bankName                String?
  crAccount               String?
  crAccountName           String?
  narration               String?
  originatorAccountNumber String?
  originatorName          String?
  paymentReference        String?
  sessionId               String?           @unique
  order                   Order?            @relation(fields: [orderId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])
  virtualAccount          VirtualAccount?   @relation(fields: [virtualAccountId], references: [id])
}

model Wallet {
  id                String              @id @default(uuid())
  userId            String              @unique
  mainBalance       Int                 @default(0)
  availableBalance  Int                 @default(0)
  collateralBalance Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
}

model WaitList {
  id    String @id @default(uuid())
  email String @unique
}

model WalletTransaction {
  id        String                  @id @default(uuid())
  walletId  String
  amount    Int
  type      WalletTransactionType   @default(MAIN)
  status    WalletTransactionStatus @default(PENDING)
  note      String?
  orderId   String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  order     Order?                  @relation(fields: [orderId], references: [id])
  wallet    Wallet                  @relation(fields: [walletId], references: [id])
}

model Escrow {
  id               String       @id @default(uuid())
  orderId          String
  listerId         String
  renterId         String
  rentalAmount     Int
  resaleAmount     Int?
  collateralAmount Int
  cleaningFee      Int
  status           EscrowStatus @default(LOCKED)
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  order            Order        @relation(fields: [orderId], references: [id])

  @@unique([orderId, listerId])
}

model VirtualAccount {
  id           String               @id @default(uuid())
  prefix       String
  vaNumber     String               @unique
  orderId      String?              @unique
  nin          String?
  bvn          String?
  userId       String
  amount       Int?
  status       VirtualAccountStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  blockReason  String?
  transactions Transaction[]
  order        Order?               @relation(fields: [orderId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                 String              @id @default(uuid())
  userId             String
  bankName           String
  bankCode           String?
  accountNumber      String
  accountName        String
  accountType        String?
  isDefault          Boolean             @default(false)
  verificationStatus String              @default("PENDING")
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  withdrawals        WithdrawalRequest[]
}

model WithdrawalRequest {
  id            String      @id @default(uuid())
  userId        String
  amount        Int
  currency      String      @default("NGN")
  bankAccountId String
  status        String      @default("PENDING")
  reference     String      @unique
  fee           Int         @default(0)
  netAmount     Int
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  paidDate      DateTime?
  trackingId    String?
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model NotificationSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  emailAlertsEnabled     Boolean  @default(true)
  emailAlertsCategories  String[]
  smsUpdatesEnabled      Boolean  @default(false)
  smsUpdatesCategories   String[]
  marketingEmailsEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actionType  String
  performedBy String
  targetType  String
  targetId    String
  targetName  String
  details     Json?
  ipAddress   String?
  status      String   @default("Success")
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminAuditLogs", fields: [performedBy], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnRequest {
  id                       String         @id @default(uuid())
  orderId                  String
  shipmentId               String?
  itemCondition            ItemCondition
  damageNotes              String?
  imageUrls                String[]
  listerCondition          ItemCondition?
  listerDamageNotes        String?
  listerConfirmationImages String[]
  status                   String         @default("PENDING_PICKUP")
  trackingNumber           String?
  pickupAddress            String?
  pickupScheduledAt        DateTime?
  pickupWindowStart        DateTime?
  pickupWindowEnd          DateTime?
  reminder24hSentAt        DateTime?
  reminderDayOfSentAt      DateTime?
  /// One-shot email to lister when return pickup window ended but return leg not yet completed (fallback if tracking lags).
  listerReturnWindowPassedNotifiedAt DateTime?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  order                    Order          @relation(fields: [orderId], references: [id])
  shipment                 Shipment?      @relation(fields: [shipmentId], references: [id])
}

enum Role {
  ADMIN
  LISTER
  RENTER
}

enum AuthOtpTokenType {
  TOKEN
  OTP
}

enum ProductStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  PENDING
  APPROVED
  REJECTED
  UNAVAILABLE
  SOLD
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  ACTIVE
  RETURN_DUE
  IN_DISPUTE
  RETURNED
  COMPLETED
  CANCELLED
  ACCEPTED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum DisputeStatus {
  IN_REVIEW
  PENDING
  WITHDRAW
  RESOLVED
  REJECTED
}

enum AvailabilityStatus {
  PENDING
  ACCEPTED
  ORDERED
  REJECTED
  EXPIRED
  CANCELLED_BY_RENTER
}

enum WalletTransactionType {
  MAIN
  AVAILABLE
  COLLATERAL
}

enum EscrowStatus {
  LOCKED
  RELEASED
  PARTIALLY_RELEASED
  REFUNDED
}

enum VirtualAccountStatus {
  PENDING
  PAID
  EXPIRED
  INACTIVE
}

enum ItemCondition {
  GOOD
  FAIR
  POOR
}

enum ListingType {
  RENTAL
  RESALE
  RENT_OR_RESALE
}

enum ShipmentType {
  OUTBOUND // Lister → Renter on rental_start_date
  RETURN // Renter → Lister on rental_end_date
  RESALE // Lister → Buyer for resale purchases (immediate dispatch)
}

enum ShipmentStatus {
  PENDING // Created at order time. Waiting for cron on scheduled_date.
  DISPATCHING // Cron has locked this record. API call in progress.
  DISPATCH_FAILED // All 3 retries exhausted. Admin notified.
  DISPATCHED // Topship API succeeded. Tracking stored.
  IN_TRANSIT // Provider confirmed rider pickup.
  COMPLETED // Delivered (OUTBOUND) or received back (RETURN).
  CANCELLED // Order cancelled before dispatch.
}

model Shipment {
  id                   String               @id @default(uuid())
  orderId              String
  listerId             String?
  type                 ShipmentType
  status               ShipmentStatus       @default(PENDING)
  /// Calendar day for dispatch eligibility when no finer window is set (see scheduler)
  scheduledDate        DateTime
  /// Relisted-only: when this leg may enter dispatch (cron/queue). Not sent to Topship as a window.
  scheduledWindowStart DateTime?
  /// Relisted-only: end of the dispatch window for UX / future rules. Not sent to Topship as a window.
  scheduledWindowEnd   DateTime?
  /// Full sender address snapshot captured at order creation time (JSON)
  pickupAddress        Json
  /// Full receiver address snapshot captured at order creation time (JSON)
  deliveryAddress      Json
  /// Topship shipment ID — populated after successful dispatch
  providerShipmentId   String?
  /// Topship tracking URL — populated after successful dispatch
  providerTrackingUrl  String?
  trackingId           String?
  /// Topship pricingTier selected by the renter at checkout (e.g. 'chowdeck', 'glovo')
  pricingTier          String?
  /// Topship shipment charge in kobo captured at checkout
  shipmentCharge       Int?
  /// Topship pickup charge in kobo captured at checkout
  pickupCharge         Int?
  /// Topship VAT charge in kobo captured at checkout
  vatCharge            Int?
  /// Topship pickup partner captured at checkout (e.g. 'chowdeck')
  pickupPartner        String?
  /// Topship pickupId captured at checkout
  pickupId             String?
  /// Single-line receiver address captured at checkout (for admin / Topship); not the pickup-partner hub string from rate APIs
  deliveryLocation     String?
  /// Relisted dispatch fallback: skip automated Topship booking until an admin marks dispatched.
  manualFulfillment    Boolean              @default(false)
  dispatchAttempts     Int                  @default(0)
  dispatchedAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  order                Order                @relation(fields: [orderId], references: [id])
  attemptLogs          DispatchAttemptLog[]
  returnRequests       ReturnRequest[]
  orderItemsOutbound   OrderItem[] @relation("OrderItemOutboundShipment")
  orderItemsReturn     OrderItem[] @relation("OrderItemReturnShipment")
  orderItemsResale     OrderItem[] @relation("OrderItemResaleShipment")

  @@index([scheduledDate, status])
}

model DispatchAttemptLog {
  id            String   @id @default(uuid())
  shipmentId    String
  attemptNumber Int
  attemptedAt   DateTime @default(now())
  success       Boolean
  errorCode     String?
  errorMessage  String?
  durationMs    Int?
  shipment      Shipment @relation(fields: [shipmentId], references: [id])
}
