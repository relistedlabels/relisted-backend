generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator dbml {
  provider   = "prisma-dbml-generator"
  output     = "./dbml"
  outputName = "schema.dbml"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  name                  String
  provider              String?
  isVerified            Boolean               @default(false)
  role                  Role                  @default(RENTER)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tokenVersion          Int                   @default(0)
  isSuspended           Boolean               @default(false)
  adminRoleId           String?
  auditLogs             AuditLog[]            @relation("AdminAuditLogs")
  tokens                AuthOtpToken[]
  listerRequests        AvailabilityRequest[] @relation("ListerAvailability")
  requestedAvailability AvailabilityRequest[] @relation("RequestedAvailability")
  bankAccounts          BankAccount[]
  brands                Brand[]
  cart                  Cart?
  disputes              Dispute[]
  favourites            Favourite[]
  notifications         Notification[]
  notificationSettings  NotificationSettings?
  orders                Order[]
  products              Product[]             @relation("CuratedProducts")
  productCategory       ProductCategory[]
  profile               Profile?
  rentalsCurated        Rental[]              @relation("Curator")
  rentalsRented         Rental[]              @relation("Rentee")
  curatorReviews        Review[]              @relation("CuratorReviews")
  reviewsWritten        Review[]
  tags                  Tag[]
  transactions          Transaction[]
  uploads               Upload[]
  adminRole             AdminRole?            @relation(fields: [adminRoleId], references: [id])
  virtualAccounts       VirtualAccount[]
  wallet                Wallet?
  withdrawalRequests    WithdrawalRequest[]
}

model Profile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  phoneNumber        String
  bvn                String?
  isApproved         Boolean           @default(false)
  avatarUploadId     String?           @unique
  ninUploadId        String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  idDocumentStatus   String            @default("NOT_UPLOADED")
  idDocumentType     String?
  idDocumentUploadId String?           @unique
  nin                String?
  address            Address?
  businessInfo       BusinessInfo?
  emergencyContact   EmergencyContact?
  avatarUpload       Upload?           @relation("AvatarUpload", fields: [avatarUploadId], references: [id])
  idDocumentUpload   Upload?           @relation("IdDocumentUpload", fields: [idDocumentUploadId], references: [id])
  ninUpload          Upload?           @relation("NinUpload", fields: [ninUploadId], references: [id])
  user               User              @relation(fields: [userId], references: [id])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  profileId    String  @unique
  name         String
  email        String?
  relationship String
  phoneNumber  String
  city         String
  state        String
  profile      Profile @relation(fields: [profileId], references: [id])
}

model BusinessInfo {
  id                         String  @id @default(uuid())
  profileId                  String  @unique
  businessName               String
  businessEmail              String
  businessRegistrationNumber String
  businessAddress            String
  businessCity               String
  businessState              String
  businessPhone              String?
  businessDescription        String?
  businessCategory           String?
  website                    String?
  profile                    Profile @relation(fields: [profileId], references: [id])
}

model Address {
  id        String   @id @default(uuid())
  profileId String   @unique
  street    String
  city      String
  state     String
  country   String
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model AuthOtpToken {
  id        String           @id @default(uuid())
  subject   String
  type      AuthOtpTokenType @default(OTP)
  code      String           @unique
  expiry    DateTime
  email     String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
}

model Product {
  id                            String                @id @default(uuid())
  name                          String
  subText                       String
  description                   String
  condition                     String
  dailyPrice                    Int
  isActive                      Boolean               @default(true)
  composition                   String?
  measurement                   String
  originalValue                 Int
  warning                       String?
  color                         String
  brandId                       String?
  categoryId                    String?
  curatorId                     String
  receiveSmsNotifications       Boolean?              @default(false)
  receiveEmailNotifications     Boolean?              @default(true)
  receiveProductRecommendations Boolean?              @default(false)
  careInstruction               String
  careSteps                     String
  stylingTip                    String
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  productVerified               Boolean               @default(false)
  quantity                      Int?
  status                        ProductStatus         @default(PENDING)
  rejectionComment              String?
  material                      String?
  collateralPrice               Int?
  attachments                   Attachments?
  AvailabilityRequests          AvailabilityRequest[]
  cartItems                     CartItem[]
  favourites                    Favourite[]
  items                         OrderItem[]
  brand                         Brand?                @relation(fields: [brandId], references: [id])
  category                      ProductCategory?      @relation(fields: [categoryId], references: [id])
  curator                       User                  @relation("CuratedProducts", fields: [curatorId], references: [id])
  rentals                       Rental[]
  reviews                       Review[]
  tags                          Tag[]                 @relation("ProductToTag")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  products  Product[]
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  userId    String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  products  Product[] @relation("ProductToTag")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  userId    String?
  imageUrl  String?
  products  Product[]
  user      User?     @relation(fields: [userId], references: [id])
}

model Upload {
  id              String       @id @default(uuid())
  name            String
  type            String
  size            Int
  url             String
  fieldName       String
  publicId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  attachmentId    String?
  userId          String
  fullText        String       @default("")
  profileAsAvatar Profile?     @relation("AvatarUpload")
  profileAsIdDoc  Profile?     @relation("IdDocumentUpload")
  profileAsNin    Profile?     @relation("NinUpload")
  attachment      Attachments? @relation(fields: [attachmentId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
}

model Attachments {
  id        String   @id @default(uuid())
  productId String?  @unique
  disputeId String?  @unique
  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  uploads   Upload[]
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  days      Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  fullText  String   @default("")
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model AvailabilityRequest {
  id                String             @id @default(uuid())
  productId         String
  cartItemId        String
  requesterId       String
  listerId          String
  status            AvailabilityStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  autoPay           Boolean            @default(false)
  deliveryAddressId String?
  endDate           DateTime?
  rentalDays        Int?
  startDate         DateTime?
  totalPrice        Int?
  lister            User               @relation("ListerAvailability", fields: [listerId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  requester         User               @relation("RequestedAvailability", fields: [requesterId], references: [id])
}

model Order {
  id                    String              @id @default(uuid())
  orderId               String              @unique
  status                OrderStatus         @default(PROCESSING)
  userId                String
  createdAt             DateTime            @default(now())
  expiresAt             DateTime?
  approvedAt            DateTime?
  updatedAt             DateTime            @updatedAt
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  returnDueAt           DateTime?
  externalTrackingUrl   String?
  shipmentId            String?
  trackingId            String?
  deliveryFee           Int?
  listerBusinessName    String?
  listerId              String?
  listerImage           String?
  listerRating          Float?
  serviceFee            Int?
  totalAmountPaid       Int?
  vatAmount             Int?
  disputes              Dispute[]
  escrows               Escrow?
  user                  User                @relation(fields: [userId], references: [id])
  orderItems            OrderItem[]
  rentals               Rental[]
  returnRequest         ReturnRequest?
  payments              Transaction[]
  virtualAccount        VirtualAccount?
  walletTransactions    WalletTransaction[]
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  days          Int
  pricePerDay   Int
  cleaningFee   Int?
  collateralFee Int?
  imageUrl      String?
  rentalFee     Int?
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
}

model Rental {
  id          String    @id @default(uuid())
  orderId     String
  productId   String
  curatorId   String
  userId      String
  days        Int
  totalAmount Int
  startDate   DateTime
  endDate     DateTime
  returnedAt  DateTime?
  isReturned  Boolean   @default(false)
  isOverdue   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  curator     User      @relation("Curator", fields: [curatorId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  user        User      @relation("Rentee", fields: [userId], references: [id])
  review      Review?
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  curatorId String
  rating    Int
  comment   String?
  rentalId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  curator   User     @relation("CuratorReviews", fields: [curatorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  rental    Rental   @relation(fields: [rentalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Dispute {
  id            String        @id @default(uuid())
  disputeId     String        @unique
  orderId       String
  userId        String
  issueCategory String
  description   String
  status        DisputeStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  attachment    Attachments?
  chatRooms     ChatRoom?
  order         Order         @relation(fields: [orderId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id        String    @id @default(uuid())
  disputeId String?   @unique
  dispute   Dispute?  @relation(fields: [disputeId], references: [id])
  message   Message[]
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  senderRole String
  content    String
  type       String    @default("TEXT")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  chatRoomId String
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id])
}

model Transaction {
  id                      String            @id @default(uuid())
  amount                  Int
  method                  String?
  status                  TransactionStatus @default(PENDING)
  orderId                 String?
  virtualAccountId        String?
  createdAt               DateTime          @default(now())
  referenceId             String            @unique
  userId                  String
  bankCode                String?
  bankName                String?
  crAccount               String?
  crAccountName           String?
  narration               String?
  originatorAccountNumber String?
  originatorName          String?
  paymentReference        String?
  sessionId               String?           @unique
  order                   Order?            @relation(fields: [orderId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])
  virtualAccount          VirtualAccount?   @relation(fields: [virtualAccountId], references: [id])
}

model Wallet {
  id                String              @id @default(uuid())
  userId            String              @unique
  mainBalance       Int                 @default(0)
  availableBalance  Int                 @default(0)
  collateralBalance Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
}

model WaitList {
  id    String @id @default(uuid())
  email String @unique
}

model WalletTransaction {
  id        String                  @id @default(uuid())
  walletId  String
  amount    Int
  type      WalletTransactionType   @default(MAIN)
  status    WalletTransactionStatus @default(PENDING)
  note      String?
  orderId   String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  order     Order?                  @relation(fields: [orderId], references: [id])
  wallet    Wallet                  @relation(fields: [walletId], references: [id])
}

model Escrow {
  id               String       @id @default(uuid())
  orderId          String       @unique
  renterId         String
  curatorId        String
  rentalAmount     Int
  collateralAmount Int
  cleaningFee      Int
  status           EscrowStatus @default(LOCKED)
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  order            Order        @relation(fields: [orderId], references: [id])
}

model VirtualAccount {
  id           String               @id @default(uuid())
  prefix       String
  vaNumber     String               @unique
  orderId      String?              @unique
  nin          String?
  bvn          String?
  userId       String
  amount       Int?
  status       VirtualAccountStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  blockReason  String?
  transactions Transaction[]
  order        Order?               @relation(fields: [orderId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                 String              @id @default(uuid())
  userId             String
  bankName           String
  bankCode           String?
  accountNumber      String
  accountName        String
  accountType        String?
  isDefault          Boolean             @default(false)
  verificationStatus String              @default("PENDING")
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  withdrawals        WithdrawalRequest[]
}

model WithdrawalRequest {
  id            String      @id @default(uuid())
  userId        String
  amount        Int
  currency      String      @default("NGN")
  bankAccountId String
  status        String      @default("PENDING")
  reference     String      @unique
  fee           Int         @default(0)
  netAmount     Int
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  paidDate      DateTime?
  trackingId    String?
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model NotificationSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  emailAlertsEnabled     Boolean  @default(true)
  emailAlertsCategories  String[]
  smsUpdatesEnabled      Boolean  @default(false)
  smsUpdatesCategories   String[]
  marketingEmailsEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions Json
  createdAt   DateTime @default(now())
  users       User[]
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value Json
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actionType  String
  performedBy String
  targetType  String
  targetId    String
  targetName  String
  details     Json?
  ipAddress   String?
  status      String   @default("Success")
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminAuditLogs", fields: [performedBy], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnRequest {
  id            String        @id @default(uuid())
  orderId       String        @unique
  itemCondition ItemCondition
  damageNotes   String?
  imageUrls     String[]
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])
}

enum Role {
  ADMIN
  LISTER
  RENTER
}

enum AuthOtpTokenType {
  TOKEN
  OTP
}

enum ProductStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  PENDING
  APPROVED
  REJECTED
  UNAVAILABLE
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  ACTIVE
  RETURN_DUE
  RETURNED
  COMPLETED
  CANCELLED
  ACCEPTED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum DisputeStatus {
  IN_REVIEW
  PENDING
  WITHDRAW
  RESELOVED
  REJECTED
}

enum AvailabilityStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED_BY_RENTER
}

enum WalletTransactionType {
  MAIN
  AVAILABLE
  COLLATERAL
}

enum EscrowStatus {
  LOCKED
  RELEASED
  PARTIALLY_RELEASED
  REFUNDED
}

enum VirtualAccountStatus {
  PENDING
  PAID
  EXPIRED
  INACTIVE
}

enum ItemCondition {
  GOOD
  FAIR
  POOR
}
