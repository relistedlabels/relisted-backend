<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .info-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border-left: 4px solid #1d72b8;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .cta {
            display: inline-block;
            margin-top: 16px;
            padding: 12px 20px;
            background: #111;
            color: #fff !important;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>{{#if emailHeading}}{{emailHeading}}{{else}}Shipping Update{{/if}}</h2>
        </div>
        <div class="content">
            <p>Hello {{userName}},</p>
            <p>There is an update on your order <strong>{{orderId}}</strong>.</p>
            <p><strong>{{status}}</strong></p>

            {{#if pickupWindowSummary}}
            <div class="info-box">
                <p><strong>Scheduled pickup window</strong></p>
                <p>{{pickupWindowSummary}}</p>
            </div>
            {{/if}}

            {{#if extraNote}}
            <p style="margin-top:12px;">{{extraNote}}</p>
            {{/if}}

            {{#if trackingUrl}}
            <div class="info-box">
                <p><strong>Tracking link</strong></p>
                <p><a href="{{trackingUrl}}" target="_blank" rel="noopener noreferrer">Open tracking page</a></p>
            </div>
            {{/if}}

            {{#if trackingNumber}}
            <div class="info-box">
                <p><strong>📦 Tracking Information</strong></p>
                <p><strong>Tracking Number:</strong> {{trackingNumber}}</p>
                {{#unless trackingUrl}}
                {{#if trackingProviderLabel}}
                <p><em>Copy your tracking number above and look it up on the {{trackingProviderLabel}} tracking page.</em></p>
                {{/if}}
                {{/unless}}
            </div>
            {{/if}}

            {{#if estimatedDelivery}}
            <p><strong>Estimated Delivery:</strong> {{estimatedDelivery}}</p>
            {{/if}}

            {{#if orderPageUrl}}
            <p style="margin:24px 0 8px;">
                <a href="{{orderPageUrl}}" class="cta" target="_blank" rel="noopener noreferrer">{{#if ctaLabel}}{{ctaLabel}}{{else}}View order{{/if}}</a>
            </p>
            {{/if}}

            <p>Thank you for choosing Relisted!</p>
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>