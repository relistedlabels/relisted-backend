<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .info-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border-left: 4px solid #1d72b8;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .cta {
            display: inline-block;
            margin-top: 16px;
            padding: 12px 20px;
            background: #111;
            color: #fff !important;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>{{#if emailHeading}}{{emailHeading}}{{else}}Shipping update{{/if}}</h2>
        </div>
        <div class="content">
            <p>Hello {{userName}},</p>
            {{#if emailHeading}}
            <p>{{emailHeading}} (order {{orderId}}).</p>
            {{else}}
            <p>Order <strong>{{orderId}}</strong> is now <strong>{{status}}</strong>.</p>
            {{/if}}

            {{#if pickupWindowSummary}}
            <div class="info-box">
                <p><strong>Pickup window:</strong> {{pickupWindowSummary}}</p>
            </div>
            {{/if}}

            {{#if extraNote}}
            <p style="margin-top:12px;">{{extraNote}}</p>
            {{/if}}

            {{#if trackingUrl}}
            <p style="margin-top:12px;"><a href="{{trackingUrl}}" target="_blank" rel="noopener noreferrer">Track shipment</a></p>
            {{else}}
            {{#if trackingNumber}}
            <div class="info-box">
                <p><strong>Tracking number:</strong> {{trackingNumber}}</p>
                {{#if trackingProviderLabel}}
                <p style="margin-top:8px;font-size:14px;color:#555;">Look it up on the {{trackingProviderLabel}} tracking page.</p>
                {{/if}}
            </div>
            {{/if}}
            {{/if}}

            {{#if estimatedDelivery}}
            <p><strong>Estimated delivery:</strong> {{estimatedDelivery}}</p>
            {{/if}}

            {{#if orderPageUrl}}
            <p style="margin:24px 0 8px;">
                <a href="{{orderPageUrl}}" class="cta" target="_blank" rel="noopener noreferrer">{{#if ctaLabel}}{{ctaLabel}}{{else}}View order{{/if}}</a>
            </p>
            {{/if}}
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
