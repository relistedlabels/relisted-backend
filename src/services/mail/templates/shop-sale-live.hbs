<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{headline}} - Relisted</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #f5f5f5;
      color: #111;
      padding: 24px;
      line-height: 1.5;
    }
    .wrapper {
      max-width: 520px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .header {
      background: #000;
      color: #fff;
      padding: 24px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 600;
    }
    .content {
      padding: 32px 24px;
    }
    .content p {
      margin: 0 0 16px;
      color: #333;
    }
    .btn {
      display: inline-block;
      width: 100%;
      max-width: 280px;
      margin: 8px 0 8px;
      padding: 14px 24px;
      background: #000;
      color: #fff !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      text-align: center;
      border-radius: 8px;
      border: none;
    }
    .footer {
      padding: 20px 24px;
      font-size: 0.75rem;
      color: #888;
      text-align: center;
      border-top: 1px solid #eee;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>{{headline}}</h1>
    </div>
    <div class="content">
      {{{emailBodyHtml}}}
      <p style="text-align: center;">
        <a href="{{shopUrl}}" class="btn">Shop now</a>
      </p>
    </div>
    <div class="footer">
      © {{currentYear}} Relisted. All rights reserved.<br />
      Buy. Sell. Relist with confidence.
    </div>
  </div>
</body>
</html>
