<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .status-accepted {
            color: green;
            font-weight: bold;
        }

        .status-rejected {
            color: red;
            font-weight: bold;
        }

        .button {
            background: #000;
            color: #fff;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>Rental Request Update</h2>
        </div>
        <div class="content">
            <p>Hello {{userName}},</p>
            <p>The lister has responded to your rental request for <strong>{{productName}}</strong>.</p>
            <p>Status: <span class="status-{{status}}">{{status}}</span></p>

            {{#if (eq status "accepted")}}
            <p>Great! Your request has been approved. Please complete your payment to secure the rental.</p>
            <p><a href="{{checkoutLink}}" class="button">Proceed to Checkout</a></p>
            {{else}}
            <p>Unfortunately, your request was not accepted at this time.</p>
            {{#if reason}}<p><strong>Reason:</strong> {{reason}}</p>{{/if}}
            {{/if}}
        </div>
        <div class="footer">
            <p>&copy; 2024 Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>