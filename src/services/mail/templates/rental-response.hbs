<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .button {
            background: #000;
            color: #fff;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>{{#if (eq requestType 'purchase')}}Purchase request update{{else}}Rental request update{{/if}}</h2>
        </div>
        <div class="content">
            <p>Hello {{userName}},</p>

            {{#if (eq status "accepted")}}
            <p><strong>{{productName}}</strong> is available for your dates. Complete checkout to lock it in.</p>
            {{#if outboundWindowSummary}}
            <p><strong>Delivery:</strong> {{outboundWindowSummary}}</p>
            {{/if}}
            {{#if returnWindowSummary}}
            <p><strong>Return pickup:</strong> {{returnWindowSummary}}</p>
            {{/if}}
            <p><a href="{{checkoutLink}}" class="button">Complete checkout</a></p>
            {{else}}
            <p>Your {{#if (eq requestType 'purchase')}}purchase{{else}}rental{{/if}} request for <strong>{{productName}}</strong> was not accepted.</p>
            {{#if reason}}<p><strong>Reason:</strong> {{reason}}</p>{{/if}}
            {{#if notes}}<p><strong>Notes:</strong> {{notes}}</p>{{/if}}
            {{/if}}
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
