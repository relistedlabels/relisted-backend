<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .details {
            margin: 16px 0;
        }

        .details p {
            margin: 4px 0;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            {{#if withdrawn}}
            <h2>{{#if (eq requestType 'purchase')}}Purchase request update{{else}}Rental request update{{/if}}</h2>
            {{else}}
            <h2>{{#if (eq requestType 'purchase')}}New purchase request{{else}}New rental request{{/if}}</h2>
            {{/if}}
        </div>
        <div class="content">
            <p>Hello {{listerName}},</p>

            {{#if withdrawn}}
            {{#if afterApproval}}
            <p>{{renterName}} cancelled their {{#if (eq requestType 'purchase')}}purchase{{else}}rental{{/if}} for <strong>{{productName}}</strong> after you approved it.</p>
            {{else}}
            <p>{{renterName}} withdrew their {{#if (eq requestType 'purchase')}}purchase{{else}}rental{{/if}} request for <strong>{{productName}}</strong>.</p>
            {{/if}}
            {{else}}
            {{#if (eq requestType 'purchase')}}
            <p><strong>{{renterName}}</strong> wants to buy <strong>{{productName}}</strong> for NGN {{totalPrice}}.</p>
            {{else}}
            <p><strong>{{renterName}}</strong> wants to rent <strong>{{productName}}</strong> for {{rentalDays}} days (NGN {{totalPrice}}).</p>
            {{/if}}

            <div class="details">
            {{#if dispatchWindows}}
            {{#each dispatchWindows}}
            <p>
                <strong>{{#if (eq type "OUTBOUND")}}Delivery{{else if (eq type "RETURN")}}Return{{else}}Resale{{/if}}:</strong>
                {{formatDateTime window.start}} to {{formatDateTime window.end}}
            </p>
            {{/each}}
            {{else}}
            {{#unless (eq startDate 'TBD')}}
            <p><strong>Dates:</strong> {{startDate}}{{#unless (eq endDate 'TBD')}} to {{endDate}}{{/unless}}</p>
            {{/unless}}
            {{/if}}
            </div>

            <p style="font-size:14px;color:#555;">Approve or decline before this request expires.</p>
            {{/if}}

            {{#if viewLink}}
            <p style="margin:20px 0;">
              <a href="{{viewLink}}" target="_blank" rel="noopener noreferrer"
                 style="background-color:#111111;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">
                View request
              </a>
            </p>
            {{else}}
            <p style="font-size:14px;color:#444444;">Open your lister dashboard to review this request.</p>
            {{/if}}
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
