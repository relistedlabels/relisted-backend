<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            {{#if withdrawn}}
            <h2>{{#if (eq requestType 'purchase')}}Purchase request update{{else}}Rental request update{{/if}}</h2>
            {{else}}
            <h2>{{#if (eq requestType 'purchase')}}New Purchase Request{{else}}New Rental Request{{/if}}</h2>
            {{/if}}
        </div>
        <div class="content">
            {{#if withdrawn}}
            <p>Hello {{listerName}},</p>
            {{#if afterApproval}}
            <p>{{renterName}} has cancelled their {{#if (eq requestType 'purchase')}}purchase{{else}}rental{{/if}} for <strong>{{productName}}</strong> after you had approved it.</p>
            {{else}}
            <p>{{renterName}} has withdrawn their {{#if (eq requestType 'purchase')}}purchase{{else}}rental{{/if}} request for <strong>{{productName}}</strong>.</p>
            {{/if}}
            {{#if viewLink}}
            <p style="margin:24px 0;text-align:left;">
              <a href="{{viewLink}}" target="_blank" rel="noopener noreferrer"
                 style="background-color:#111111;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;line-height:1.2;">
                View Request
              </a>
            </p>
            <p style="font-size:14px;color:#444444;line-height:1.5;word-break:break-all;">
            You can also view the request here:<br />
              <a href="{{viewLink}}" style="color:#111111;text-decoration:underline;">{{viewLink}}</a>
            </p>
            {{else}}
            <p style="font-size:14px;color:#444444;">Please open your lister dashboard to review this request.</p>
            {{/if}}
            {{else}}
            <p>Hello {{listerName}},</p>
            {{#if (eq requestType 'purchase')}}
            <p>You have a new purchase request for your item: <strong>{{productName}}</strong>.</p>
            <p><strong>From:</strong> {{renterName}}</p>
            <p><strong>Purchase Price:</strong> NGN {{totalPrice}}</p>
            {{else}}
            <p>You have a new rental request for your item: <strong>{{productName}}</strong>.</p>
            <p><strong>From:</strong> {{renterName}}</p>
            <p><strong>Duration:</strong> {{rentalDays}} days</p>
            <p><strong>Price:</strong> NGN {{totalPrice}}</p>
            <p><strong>Dates:</strong> {{startDate}} - {{endDate}}</p>
            {{/if}}
            <p>Please log in to your dashboard to approve or decline this request before it expires.</p>
            {{#if viewLink}}
            <p style="margin:24px 0;text-align:left;">
              <a href="{{viewLink}}" target="_blank" rel="noopener noreferrer"
                 style="background-color:#111111;color:#ffffff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;line-height:1.2;">
                View Request
              </a>
            </p>
            <p style="font-size:14px;color:#444444;line-height:1.5;word-break:break-all;">
            You can also view the request here:<br />
              <a href="{{viewLink}}" style="color:#111111;text-decoration:underline;">{{viewLink}}</a>
            </p>
            {{else}}
            <p style="font-size:14px;color:#444444;">Please open your lister dashboard to review pending rental requests.</p>
            {{/if}}
            {{/if}}
        </div>
        <div class="footer">
            <p>&copy; 2024 Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>