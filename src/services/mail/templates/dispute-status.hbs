<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background:#f6f7fb; padding:24px;">
  <div style="max-width:640px; margin:0 auto; background:#ffffff; border:1px solid #e6e8ef; border-radius:12px; overflow:hidden;">
    <div style="padding:18px 20px; background:#111827; color:#ffffff;">
      <div style="font-size:14px; opacity:0.9;">Relisted</div>
      {{#if (eq status "created")}}
        <div style="font-size:18px; font-weight:700; margin-top:6px;">New Dispute Created</div>
      {{else}}
        <div style="font-size:18px; font-weight:700; margin-top:6px;">Dispute Update</div>
      {{/if}}
    </div>

    <div style="padding:20px;">
      <p style="margin:0 0 12px;">Hello {{userName}},</p>
      {{#if (eq status "created")}}
        <p style="margin:0 0 16px; color:#374151;">A new dispute has been created.</p>
      {{else}}
        <p style="margin:0 0 16px; color:#374151;">Your dispute has been updated.</p>
      {{/if}}

      <div style="border:1px solid #eef0f5; border-radius:10px; padding:14px 16px; background:#fbfbfe;">
        <div style="display:flex; gap:12px; flex-wrap:wrap; color:#111827;">
          <div style="min-width:220px;">
            <div style="font-size:12px; color:#6b7280;">Dispute ID</div>
            <div style="font-weight:600;">{{disputeId}}</div>
          </div>
          <div style="min-width:220px;">
            <div style="font-size:12px; color:#6b7280;">Order</div>
            <div style="font-weight:600;">{{orderId}}</div>
          </div>
          <div style="min-width:220px;">
            <div style="font-size:12px; color:#6b7280;">Status</div>
            <div style="font-weight:600;">{{status}}</div>
          </div>
          {{#if category}}
            <div style="min-width:220px;">
              <div style="font-size:12px; color:#6b7280;">Issue</div>
              <div style="font-weight:600;">{{category}}</div>
            </div>
          {{/if}}
        </div>
        {{#if description}}
          <div style="margin-top:12px;">
            <div style="font-size:12px; color:#6b7280;">Description</div>
            <div style="margin-top:6px; color:#111827; line-height:1.45; white-space:pre-wrap;">{{description}}</div>
          </div>
        {{/if}}
      </div>

      {{#if collateralWithheldToLister}}
        <p style="margin:14px 0 0;"><strong>Collateral withheld:</strong> {{collateralWithheldToLister}}</p>
      {{/if}}
      {{#if collateralReturnedToRenter}}
        <p style="margin:10px 0 0;"><strong>Collateral returned:</strong> {{collateralReturnedToRenter}}</p>
      {{/if}}

      {{#if disputeLink}}
        <div style="margin-top:18px;">
          <a href="{{disputeLink}}" style="display:inline-block; background:#111827; color:#ffffff; text-decoration:none; padding:10px 14px; border-radius:10px; font-weight:600;">
            View Disputes
          </a>
          <div style="margin-top:10px; font-size:12px; color:#6b7280;">
            If the button doesn’t work, open: <span style="color:#111827;">{{disputeLink}}</span>
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>
