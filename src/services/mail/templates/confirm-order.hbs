<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Order Confirmation</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f7f7f7;
        padding: 20px;
      }
      .container {
        background-color: #ffffff;
        padding: 20px;
        border-radius: 6px;
      }
      .header {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
      }
      .summary {
        margin-top: 15px;
      }
      .summary p {
        margin: 4px 0;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #777;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">Your Order Has Been Confirmed 🎉</div>

      <p>Hello {{name}},</p>

      <p>
        Thank you for your order! Your rental request has been successfully
        placed.
      </p>

      <div class="summary">
        <p><strong>Order ID:</strong> {{orderId}}</p>
        <p><strong>Total Amount:</strong> ₦{{totalAmount}}</p>
        <p><strong>Status:</strong> Processing</p>
      </div>

      <p>
        You will be notified once your items are delivered. Please confirm
        receipt in the app to begin your rental period.
      </p>

      <p>
        If you have any questions, feel free to contact our support team.
      </p>

      <div class="footer">
        <p>— The {{platformName}} Team</p>
      </div>
    </div>
  </body>
</html>
