<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
    .button {
      display: inline-block;
      padding: 10px 20px;
      margin: 15px 0;
      background-color: #1d72b8;
      color: white;
      text-decoration: none;
      border-radius: 5px;
    }
    .order-summary {
      border-top: 1px solid #ddd;
      margin-top: 10px;
      padding-top: 10px;
    }
    .info-box {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin: 15px 0;
      border-left: 4px solid #1d72b8;
    }
  </style>
</head>
<body>
  <div class="container">
    {{#if listerNewOrderConfirmed}}
    <h2>Hello {{curatorName}},</h2>
    <p>You have a new confirmed order from {{renterName}}.</p>
    <p><strong>Order ID:</strong> {{orderId}}</p>

    <p>
      {{#if (gt listerRentalSubtotal 0)}}<strong>Rental subtotal:</strong> ₦{{listerRentalSubtotal}}<br />{{/if}}
      {{#if (gt listerCleaningFeesTotal 0)}}<strong>Cleaning fees:</strong> ₦{{listerCleaningFeesTotal}}<br />{{/if}}
      {{#if (gt listerResaleSubtotal 0)}}<strong>Resale:</strong> ₦{{listerResaleSubtotal}}<br />{{/if}}
      <strong>Your total:</strong> ₦{{listerMerchandiseTotal}}
    </p>

    <p><strong>Items</strong></p>
    <ul>
      {{#each items}}
      <li>{{this.productName}}</li>
      {{/each}}
    </ul>

    {{#if hasDispatchItemWindows}}
    {{#each dispatchItemWindows}}
    <div class="info-box">
      <p><strong>{{this.productName}}</strong></p>
      {{#if this.rentalDeliveryWindowText}}
      <p><strong>Rental delivery:</strong> {{this.rentalDeliveryWindowText}}</p>
      {{/if}}
      {{#if this.returnPickupWindowText}}
      <p><strong>Return pickup:</strong> {{this.returnPickupWindowText}}</p>
      {{/if}}
      {{#if this.purchaseDeliveryWindowText}}
      <p><strong>Purchase delivery:</strong> {{this.purchaseDeliveryWindowText}}</p>
      {{/if}}
    </div>
    {{/each}}
    <p>Prepare each item for its listed window.</p>
    <p>Missing a scheduled window may lead to extra charges to reschedule.</p>
    {{else}}
    <div class="info-box">
      <p><strong>Dispatch</strong></p>
      <p>Open your dashboard for full pickup and delivery timing.</p>
    </div>
    {{/if}}

    <p><a href="{{approvalLink}}" class="button">View order in dashboard</a></p>
    {{else}}
    {{#if curatorName}}
    <!-- Lister: legacy flow when order still requires lister approval (e.g. availability not yet paid) -->
    <h2>Hello {{curatorName}},</h2>
    <p>You have a new {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}} awaiting your approval.</p>

    <p><strong>Order ID:</strong> {{orderId}}</p>
    <p><strong>Renter Name:</strong> {{renterName}}</p>
    <p><strong>Total Amount:</strong> ₦{{totalAmount}}</p>

    <div class="order-summary">
      <h3>{{#if (eq requestType 'purchase')}}Purchase Item{{else}}Order Item{{/if}}:</h3>
      <ul>
        {{#each items}}
          {{#if (eq ../requestType 'purchase')}}
          <li>
            {{this.productName}}: ₦{{this.price}}
          </li>
          {{else}}
          <li>
            {{this.productName}}: {{this.days}} day(s) at ₦{{this.pricePerDay}}/day
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </div>

    <p>Please review the product and click the button below to approve the {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}}:</p>
    <a href="{{approvalLink}}" class="button">{{#if (eq requestType 'purchase')}}Accept Purchase{{else}}Accept Order{{/if}}</a>

    <p>If you do not approve this {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}} within 30 minutes, it will expire automatically.</p>
    {{else}}
    <!-- Customer order confirmation email -->
    <h2>Hello {{customerName}},</h2>
    <p>Your order has been confirmed successfully!</p>

    <p><strong>Order ID:</strong> {{orderId}}</p>
    <p><strong>Total Amount:</strong> ₦{{totalAmount}}</p>

    <div class="info-box">
      <p><strong>📦 Shipping Information</strong></p>
      <p>Your tracking link will be sent to you on your rental start date. You'll be able to track your shipment in real-time once it's dispatched.</p>
    </div>

    <p>You can view your order details and track its status in your account dashboard.</p>
    {{/if}}
    {{/if}}

    <p>Thanks,<br>The Relisted Team</p>
  </div>
</body>
</html>
