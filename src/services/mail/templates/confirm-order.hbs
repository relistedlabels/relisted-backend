<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmed</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
    .button,
    a.button,
    a.button:link,
    a.button:visited,
    a.button:hover,
    a.button:active {
      display: inline-block;
      padding: 10px 20px;
      background-color: #1d72b8;
      color: #ffffff !important;
      text-decoration: none !important;
      border-radius: 5px;
    }
    .email-footer {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #ddd;
    }
    .email-footer p {
      margin: 0 0 12px;
    }
    .email-footer p:last-child {
      margin-bottom: 0;
    }
    .order-summary {
      border-top: 1px solid #ddd;
      margin-top: 10px;
      padding-top: 10px;
    }
    .info-box {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin: 15px 0;
      border-left: 4px solid #1d72b8;
    }
    .item-image {
      width: 72px;
      height: 72px;
      object-fit: cover;
      border-radius: 6px;
      display: block;
    }
    .item-detail-row p {
      margin: 0 0 8px;
    }
    .item-window-row {
      margin-top: 10px;
    }
    .item-window-row p {
      margin: 0 0 8px;
    }
  </style>
</head>
<body>
  <div class="container">
    {{#if listerNewOrderConfirmed}}
    <h2>Hello {{curatorName}},</h2>
    <p>You have a new confirmed order from {{renterName}}.</p>

    <p><strong>Order ID:</strong> {{#if approvalLink}}<a href="{{approvalLink}}">{{orderId}}</a>{{else}}{{orderId}}{{/if}}</p>

    <p>
      {{#if (gt listerRentalSubtotal 0)}}<strong>Rental subtotal:</strong> ₦{{listerRentalSubtotal}}<br />{{/if}}
      {{#if (gt listerCleaningFeesTotal 0)}}<strong>Cleaning fees:</strong> ₦{{listerCleaningFeesTotal}}<br />{{/if}}
      {{#if (gt listerResaleSubtotal 0)}}<strong>Resale:</strong> ₦{{listerResaleSubtotal}}<br />{{/if}}
      <strong>Your total:</strong> ₦{{listerMerchandiseTotal}}
    </p>

    {{#if hasOrderLines}}
    <div class="order-summary">
      <p><strong>Items</strong></p>
      {{> order-line-items}}
    </div>
    {{/if}}

    <div class="email-footer">
      {{#if approvalLink}}
      <p><a href="{{approvalLink}}" class="button" style="display:inline-block;padding:10px 20px;background-color:#1d72b8;color:#ffffff !important;text-decoration:none !important;border-radius:5px;">View order in dashboard</a></p>
      {{/if}}
      <p>Prepare each item for its listed window.</p>
      <p>Missing a scheduled window may lead to extra charges to reschedule.</p>
      <p>Thanks,<br />The Relisted Team</p>
    </div>
    {{else}}
    {{#if curatorName}}
    <!-- Lister: legacy flow when order still requires lister approval (e.g. availability not yet paid) -->
    <h2>Hello {{curatorName}},</h2>
    <p>You have a new {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}} awaiting your approval.</p>

    <p><strong>Order ID:</strong> {{orderId}}</p>
    <p><strong>Renter Name:</strong> {{renterName}}</p>
    <p><strong>Total Amount:</strong> ₦{{totalAmount}}</p>

    <div class="order-summary">
      <h3>{{#if (eq requestType 'purchase')}}Purchase Item{{else}}Order Item{{/if}}:</h3>
      <ul>
        {{#each items}}
          {{#if (eq ../requestType 'purchase')}}
          <li>
            {{this.productName}}: ₦{{this.price}}
          </li>
          {{else}}
          <li>
            {{this.productName}}: {{this.days}} day(s) at ₦{{this.pricePerDay}}/day
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </div>

    <p>Please review the product and click the button below to approve the {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}}:</p>
    <a href="{{approvalLink}}" class="button" style="display:inline-block;padding:10px 20px;background-color:#1d72b8;color:#ffffff !important;text-decoration:none !important;border-radius:5px;">{{#if (eq requestType 'purchase')}}Accept Purchase{{else}}Accept Order{{/if}}</a>

    <p>If you do not approve this {{#if (eq requestType 'purchase')}}purchase{{else}}order{{/if}} within 30 minutes, it will expire automatically.</p>
    <p>Thanks,<br>The Relisted Team</p>
    {{else}}
    <!-- Customer order confirmation email -->
    <h2>Hello {{customerName}},</h2>
    <p>Your order has been confirmed successfully!</p>

    <p><strong>Order ID:</strong> {{#if orderLink}}<a href="{{orderLink}}">{{orderId}}</a>{{else}}{{orderId}}{{/if}}</p>
    <p><strong>Total Amount:</strong> ₦{{totalAmount}}</p>

    {{#if hasOrderLines}}
    <div class="order-summary">
      <p><strong>Your items</strong></p>
      {{> order-line-items}}
    </div>
    {{/if}}

    <div class="email-footer">
      {{#if orderLink}}
      <p><a href="{{orderLink}}" class="button" style="display:inline-block;padding:10px 20px;background-color:#1d72b8;color:#ffffff !important;text-decoration:none !important;border-radius:5px;">View order</a></p>
      {{/if}}
      <p>You will receive a tracking link for your order once it is dispatched.</p>
      <p>Thanks,<br />The Relisted Team</p>
    </div>
    {{/if}}
    {{/if}}
  </div>
</body>
</html>
