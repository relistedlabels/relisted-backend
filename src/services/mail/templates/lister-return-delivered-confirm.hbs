<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .item-box {
            background: #f8f9fa;
            padding: 14px 16px;
            border-radius: 8px;
            margin: 16px 0;
            border-left: 4px solid #2e7d32;
        }

        .item-image {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border-radius: 8px;
            display: block;
        }

        .cta {
            display: inline-block;
            margin-top: 16px;
            padding: 12px 20px;
            background: #2e7d32;
            color: #fff !important;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>Confirm return receipt</h2>
        </div>
        <div class="content">
            <p>Hello {{curatorName}},</p>
            <p>The return for order <strong>{{orderNumber}}</strong> was delivered. Confirm receipt in the app to complete the order and release funds.</p>

            {{#if returnItems}}
            {{#each returnItems}}
            <div class="item-box">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                    <tr>
                        {{#if this.imageUrl}}
                        <td valign="top" width="84" style="padding-right: 12px;">
                            <img src="{{this.imageUrl}}" alt="{{this.name}}" class="item-image" width="72" height="72" />
                        </td>
                        {{/if}}
                        <td valign="top">
                            <p style="margin: 0;"><strong>{{this.name}}</strong></p>
                        </td>
                    </tr>
                </table>
            </div>
            {{/each}}
            {{/if}}

            {{#if trackingNumber}}
            <p><strong>Tracking:</strong> {{trackingNumber}}</p>
            {{/if}}

            <p><a class="cta" href="{{orderPageUrl}}" target="_blank">Confirm return receipt</a></p>

            <p style="font-size:14px;color:#555;">If you don't confirm within {{autoConfirmPeriodLabel}}, we'll automatically complete the order, return the renter's deposit, and credit your earnings.</p>
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} {{platformName}}. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
