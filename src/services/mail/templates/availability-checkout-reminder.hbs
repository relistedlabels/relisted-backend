<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }

        .container {
            width: 80%;
            margin: 20px auto;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 10px;
        }

        .header {
            background: #f8f9fa;
            padding: 10px;
            text-align: center;
            border-bottom: 2px solid #555;
        }

        .content {
            padding: 20px;
        }

        .footer {
            font-size: 12px;
            color: #777;
            margin-top: 20px;
            text-align: center;
        }

        .button {
            background: #000;
            color: #fff;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h2>{{title}}</h2>
        </div>
        <div class="content">
            <p>Hello {{userName}},</p>
            {{#if items}}
            {{#if (eq stage "15m")}}
            <p>These approved items are waiting in your cart. Check out soon to lock them in.</p>
            {{else}}
            {{#if (eq stage "1h")}}
            <p>Reminder: these items are still waiting in your cart.</p>
            {{else}}
            <p>Last reminder: check out before you lose these items.</p>
            {{/if}}
            {{/if}}
            <ul>
                {{#each items}}
                <li><strong>{{productName}}</strong></li>
                {{/each}}
            </ul>
            {{else}}
            {{#if (eq stage "15m")}}
            <p><strong>{{productName}}</strong> is available. Check out soon to lock it in.</p>
            {{else}}
            {{#if (eq stage "1h")}}
            <p><strong>{{productName}}</strong> is still waiting in your cart.</p>
            {{else}}
            <p>Last reminder: check out for <strong>{{productName}}</strong> before you lose it.</p>
            {{/if}}
            {{/if}}
            {{/if}}
            <p><a href="{{cartLink}}" class="button">Open cart and check out</a></p>
        </div>
        <div class="footer">
            <p>&copy; {{currentYear}} Relisted. All rights reserved.</p>
        </div>
    </div>
</body>

</html>
